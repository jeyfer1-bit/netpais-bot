# Copia este archivo como ".env" y llena los valores reales.
# NUNCA subas el archivo ".env" real a GitHub.

# Token de acceso que copiaste del panel de WhatsApp en Meta for Developers
WHATSAPP_TOKEN=

# El Phone Number ID que viste en el panel (ej: 1359415357249667)
PHONE_NUMBER_ID=

# Cualquier palabra que tú inventes. Debe coincidir EXACTAMENTE
# con lo que pongas en el campo "Token de verificación" del panel de Meta.
VERIFY_TOKEN=mi_token_secreto_123

# Puerto local (Railway lo asigna automáticamente en producción)
PORT=3000
